# ============================================================
# MIIF — Manchester Igbo Iriji Festival
# Hostinger (LiteSpeed / Apache) Web Server Configuration
# ============================================================

RewriteEngine On

# 1. Force HTTPS (optional / recommended on Hostinger)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect /index or /index.html to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?\ HTTP/
RewriteRule ^index(\.html)?$ / [R=301,L]

# 3. External redirect: strip .html extension from URL bar
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# 4. Internal rewrite: silently serve .html file for extensionless URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ------------------------------------------------------------
# Security & Performance Settings
# ------------------------------------------------------------

# Disable directory browsing
Options -Indexes

# Set UTF-8 encoding
AddDefaultCharset UTF-8

# Leverage Browser Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
